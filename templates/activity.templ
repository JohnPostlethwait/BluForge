package templates

import (
	"fmt"
	"github.com/johnpostlethwait/bluforge/templates/components"
)

// ActivityPageData holds all data needed to render the activity page.
type ActivityPageData struct {
	StoreJSON string // JSON blob for Alpine.store('activity') hydration
	Flash     string
}

templ Activity(data ActivityPageData) {
	@Layout("Activity") {
		@templ.Raw(fmt.Sprintf(`<script>
document.addEventListener('alpine:init', () => {
	Alpine.store('activity', %s)
	Alpine.store('activity').contributionAvailable = false
	Alpine.store('activity').contributionId = null
	Alpine.store('activity').contributionDiscName = ''
	Alpine.store('activity').now = Date.now()
	// Salvage state is client-side until an event arrives. Without defaults the
	// store has undefined where the banner and the buttons expect values, and
	// the page renders inert controls with empty labels.
	Alpine.store('activity').salvageActive = false
	Alpine.store('activity').salvagePhase = ''
	Alpine.store('activity').salvageMessage = ''
	Alpine.store('activity').salvagePercent = 0
	Alpine.store('activity').salvageUnrecovered = 0
	Alpine.store('activity').salvageStartedAt = 0
	Alpine.store('activity').salvageDriveIndex = null
	Alpine.store('activity').salvageDisc = ''
	Alpine.store('activity').salvageResumable = false
	Alpine.store('activity').salvageRun = 0
	Alpine.store('activity').salvageStoppingRun = -1
	// A page loaded during a salvage has seen no events. The server says what is
	// running so the panel is there immediately rather than after the next
	// update, which during a quiet phase can be minutes away.
	applySalvageState(Alpine.store('activity').salvage)
	setInterval(() => Alpine.store('activity').now = Date.now(), 1000) // drives live elapsed/ETA update on active rip cards
	Alpine.store('activityError', '')
	Alpine.store('activityTab', new URLSearchParams(window.location.search).get('tab') || 'active')
	window.addEventListener('popstate', () => {
		Alpine.store('activityTab', new URLSearchParams(window.location.search).get('tab') || 'active')
	})

	const evtSource = new EventSource('/events')

	// The event stream is a live hint, not a record: no replay, dropped for slow
	// clients, and killed outright by a sleeping laptop. Everything below builds
	// on events, so without somewhere authoritative to ask, anything missed
	// while this page was away stayed missing until a manual reload.
	let _sseEverOpen = false
	evtSource.addEventListener('open', () => {
		if (_sseEverOpen) resyncActivity()
		_sseEverOpen = true
	})
	document.addEventListener('visibilitychange', () => {
		if (document.visibilityState === 'visible') resyncActivity()
	})

	// A salvage runs for hours and produces a file MakeMKV would refuse to make.
	// Nothing here happens without the user reading what that means and agreeing.
	evtSource.addEventListener('disc_salvage', (e) => {
		const update = JSON.parse(e.data)
		const store = Alpine.store('activity')

		// A cancelled run keeps reporting for a moment while its processes die.
		// Those events landing on the run that replaced it made the spinner return
		// seconds after a pause, and a resumed salvage pause itself.
		const run = update.run || 0
		if (run < (store.salvageRun || 0)) return
		store.salvageRun = run

		// A run that has been told to stop keeps reporting for a moment: its
		// progress messages are already in flight when Pause is clicked, and they
		// carry the current run number, so a filter on older runs does not catch
		// them. They arrived after the pause and set the state back to running,
		// which is why a paused salvage appeared to start itself again. Only the
		// run's own ending is worth hearing once it has been stopped.
		const terminal = ['paused', 'failed', 'done'].includes(update.phase)
		if (run === store.salvageStoppingRun && !terminal) return

		store.salvagePhase = update.phase
		store.salvageMessage = update.message || ''
		store.salvagePercent = update.percent || 0
		store.salvageUnrecovered = update.unrecovered || 0
		store.salvageResumable = !!update.resumable
		if (update.drive_index !== undefined) store.salvageDriveIndex = update.drive_index
		store.salvageActive = ['starting', 'backing-up', 'rescuing', 'verifying'].includes(update.phase)
		if (store.salvageActive && !store.salvageStartedAt) store.salvageStartedAt = Date.now()
	})

	evtSource.addEventListener('rip-update', (e) => {
		const job = JSON.parse(e.data)
		const store = Alpine.store('activity')

		// Update active job progress.
		const active = store.active.find(j => j.id === job.ID)

		// A job this page has never heard of. Every rip submitted from a drive
		// page while this tab was open arrived here, was matched against an
		// empty store.active, and was dropped — so the rip ran to completion
		// without ever appearing. The server knows about it; ask.
		if (!active) {
			if (job.Status === 'ripping' || job.Status === 'organizing') resyncActivity()
			return
		}

		active.progress = job.Progress
		active.status = job.Status
		active.startedAt = job.StartedAt
		// Until MakeMKV starts copying, its progress describes an analysis
		// pass and says nothing about bytes written.
		active.phase = job.Phase || ''

		// Move to completed when done.
		if (job.Status === 'completed' || job.Status === 'failed') {
			store.active = store.active.filter(j => j.id !== job.ID)
			store.completed.unshift({
				id: job.ID,
				discName: job.DiscName,
				titleName: job.TitleName,
				contentType: active.contentType,
				status: job.Status,
				progress: job.Progress,
				error: job.Error || '',
				finishedAt: new Date().toLocaleString(),
				sizeHuman: active.sizeHuman || '',
				duration: active.duration || '',
				audioTracks: active.audioTracks || [],
				subtitleLanguages: active.subtitleLanguages || [],
			})

			// Also add to history so it appears in the History tab immediately.
			// Remove any existing entry for this job first (guards against
			// duplicates if the page was loaded while the job was in-flight).
			store.history = store.history.filter(r => r.id !== job.ID)
			store.history.unshift({
				id: job.ID,
				discName: job.DiscName,
				titleName: job.TitleName,
				contentType: active.contentType,
				status: job.Status,
				error: job.Error || '',
				duration: '',
				outputPath: '',
				createdAt: new Date().toLocaleString(),
				sizeHuman: active.sizeHuman || '',
				audioTracks: active.audioTracks || [],
				subtitleLanguages: active.subtitleLanguages || [],
			})

			// Promote next queued job to active.
			const nextIdx = store.pending.findIndex(j => j.driveIndex === active.driveIndex)
			if (nextIdx !== -1) {
				const next = store.pending.splice(nextIdx, 1)[0]
				next.status = 'ripping'
				next.progress = 0
				store.active.push(next)
			}
		}
	})

	evtSource.addEventListener('contribution_available', (e) => {
		const d = JSON.parse(e.data)
		const store = Alpine.store('activity')
		store.contributionAvailable = true
		store.contributionId = d.contribution_id
		store.contributionDiscName = d.disc_name
	})
})

// applySalvageState draws the salvage panel from what the server reports.
//
// A salvage runs for hours and can be silent for minutes, so a page that has
// seen no events still has to show one that is running — or one that was paused
// and is waiting to be resumed, which survives even a restart. Shared by the
// initial hydration and every resync, so the two cannot drift.
function applySalvageState(cur) {
	const store = Alpine.store('activity')
	if (!store) return
	cur = cur || {}

	if (cur.active || cur.paused) {
		store.salvageDriveIndex = cur.driveIndex
		store.salvageDisc = cur.discLabel || ''
		store.salvageResumable = !!cur.resumable
	}
	if (cur.active) {
		store.salvageActive = true
		store.salvagePhase = 'backing-up'
		if (!store.salvageStartedAt) store.salvageStartedAt = Date.now()
	} else if (cur.paused) {
		// A salvage stopped with work on disk. The page must offer to resume it,
		// whether it was paused a minute ago or before a restart.
		store.salvageActive = false
		store.salvagePhase = 'paused'
		store.salvageMessage = 'Paused. Everything recovered so far is kept.'
	} else if (store.salvageActive) {
		// The page believes a salvage is running and the server says none is, so
		// it ended while this page was disconnected — and the terminal event that
		// would have taken the spinner down is gone for good. Left alone, the
		// panel reads "Copying the disc" for work that finished hours ago.
		//
		// Marked done rather than blanked: it did finish, and the panel's own
		// done message is a truer thing to show than nothing at all.
		store.salvageActive = false
		store.salvagePhase = 'done'
	}
}

// resyncActivity replaces the job lists with the server's view.
//
// The lists are entirely server-derived, so they can be taken wholesale. Local
// UI state — the open tab, the history filter, a salvage this page has just
// asked to pause — is deliberately left alone.
async function resyncActivity() {
	const store = Alpine.store('activity')
	if (!store) return
	try {
		const resp = await fetch('/activity', { headers: { 'Accept': 'application/json' } })
		if (!resp.ok) return
		const s = await resp.json()

		store.active = s.active || []
		store.pending = s.pending || []
		store.history = s.history || []
		store.hasMore = s.hasMore
		store.discsWithBackup = s.discsWithBackup || []

		// The server is authoritative about the salvage, including one that was
		// paused before this page existed. Not guarded against a pause this page
		// has just asked for: salvageStoppingRun is only cleared when a salvage
		// is started or resumed, so guarding on it would silently stop the panel
		// resyncing for the rest of the page's life after any pause — a far
		// worse outcome than the millisecond window between clicking Pause and
		// the server acting on it.
		store.salvage = s.salvage || {}
		applySalvageState(store.salvage)
	} catch (err) {
		// A failed resync is not worth surfacing: the next reconnect or tab
		// focus tries again.
	}
}

// salvageDisc asks before doing anything, because a salvage is a deliberate
// departure from how MakeMKV behaves: it writes a file containing damaged video
// rather than refusing to write one at all.
// pauseSalvage stops the run and keeps what it has. The word is "pause" because
// that is what it is from the outside: resuming continues from the same place.
async function pauseSalvage(driveIndex) {
	const store = Alpine.store('activity')
	// Show the pause immediately, and stop believing anything this run says
	// except how it ends: its progress messages are already on their way.
	store.salvageStoppingRun = store.salvageRun
	store.salvageActive = false
	store.salvagePhase = 'paused'
	store.salvageMessage = 'Paused. Everything recovered so far is kept.'
	try {
		const resp = await fetch('/drives/' + driveIndex + '/salvage/pause', {
			method: 'POST',
			headers: { 'Accept': 'application/json' },
		})
		const info = await resp.json().catch(() => ({}))
		if (info.message) store.salvageMessage = info.message
	} catch (err) {
		store.salvageMessage = 'Could not pause: ' + err.message
	}
}

// resumeSalvage restarts the salvage for the drive the panel is about. ddrescue
// continues from its map, so this picks up rather than starting over.
async function resumeSalvage() {
	const store = Alpine.store('activity')
	const idx = store.salvageDriveIndex
	if (idx === null || idx === undefined) return
	// Do not guess the phase: a resume skips the copy when one is already on
	// disk, and claiming "Copying the disc" here said so regardless.
	store.salvagePhase = 'starting'
	store.salvageActive = true
	store.salvageMessage = ''
	store.salvagePercent = 0
	store.salvageStartedAt = Date.now()
	store.salvageStoppingRun = -1
	try {
		const disc = store.salvageDisc || ''
		await fetch('/drives/' + idx + '/salvage' + (disc ? '?disc=' + encodeURIComponent(disc) : ''), {
			method: 'POST',
			headers: { 'Accept': 'application/json' },
		})
	} catch (err) {
		store.salvageActive = false
		store.salvagePhase = 'failed'
		store.salvageMessage = 'Could not resume: ' + err.message
	}
}

// discHasBackup reports whether a repaired copy of this disc is still on disk.
//
// History lists every rip that ever came off a copy, but most of those copies
// were deleted the moment their rip succeeded. Offering to discard one that is
// already gone is a button that does nothing.
function discHasBackup(discName) {
	if (!discName) return false
	const discs = Alpine.store('activity').discsWithBackup || []
	return discs.includes(discName)
}

// discardDiscBackup deletes the repaired copy a finished rip came from.
//
// Keyed by disc, not drive: a history row may name a drive that has since been
// renumbered or unplugged, and a stale index would delete another disc's copy.
async function discardDiscBackup(discName) {
	const agreed = confirm(
		'Discard the scanned copy of ' + discName + '?\n\n' +
		'This frees the space it is using. The files already ripped from it are ' +
		'not affected.\n\n' +
		'Ripping this disc again would have to read the damaged disc from the ' +
		'start, which takes hours and may not succeed.'
	)
	if (!agreed) return

	const store = Alpine.store('activity')
	try {
		const body = new URLSearchParams({ disc: discName })
		const resp = await fetch('/activity/discard-backup', {
			method: 'POST',
			headers: {
				'Accept': 'application/json',
				'Content-Type': 'application/x-www-form-urlencoded',
			},
			body,
		})
		if (!resp.ok) {
			const info = await resp.json().catch(() => ({}))
			alert(info.message || ('The copy could not be discarded (HTTP ' + resp.status + ')'))
			return
		}
		// The copy is gone, so the offer goes with it.
		store.discsWithBackup = (store.discsWithBackup || []).filter(d => d !== discName)
	} catch (err) {
		alert('The copy could not be discarded: ' + err)
	}
}

async function salvageDisc(driveIndex, discName) {
	const agreed = confirm(
		'Salvage this disc?\n\n' +
		'BluForge will copy what the drive can still read and leave the unreadable ' +
		'parts blank. MakeMKV normally refuses to rip a disc it cannot read ' +
		'completely — this deliberately overrides that.\n\n' +
		'The result will contain DAMAGED VIDEO wherever the disc is unreadable. ' +
		'You will not know how much until it finishes.\n\n' +
		'This takes a few hours and needs roughly twice the disc size in free space.\n\n' +
		'Leave the disc in the drive until it completes.'
	)
	if (!agreed) return

	const store = Alpine.store('activity')
	store.salvageActive = true
	store.salvagePhase = 'backing-up'
	store.salvageMessage = ''
	store.salvagePercent = 0
	store.salvageStartedAt = Date.now()
	store.salvageStoppingRun = -1
	store.salvageDriveIndex = driveIndex
	store.salvageDisc = discName || ''

	try {
		// The disc, not the drive number: a drive that re-enumerated between the
		// rip and now would otherwise send this at the wrong drive.
		const url = '/drives/' + driveIndex + '/salvage' +
			(discName ? '?disc=' + encodeURIComponent(discName) : '')
		const resp = await fetch(url, {
			method: 'POST',
			headers: { 'Accept': 'application/json' },
		})
		const info = await resp.json().catch(() => ({}))
		if (!resp.ok) {
			store.salvageActive = false
			store.salvagePhase = 'failed'
			store.salvageMessage = info.message || ('Salvage could not start (HTTP ' + resp.status + ')')
			return
		}
		store.salvageMessage = info.message || ''
	} catch (err) {
		store.salvageActive = false
		store.salvagePhase = 'failed'
		store.salvageMessage = 'Salvage request failed: ' + err.message
	}
}

async function cancelJob(jobId, btn) {
	if (btn) btn.disabled = true
	try {
		const resp = await fetch('/activity/' + jobId + '/cancel', {
			method: 'POST',
			headers: { 'Accept': 'application/json' },
		})
		if (resp.ok) {
			const store = Alpine.store('activity')
			store.active = store.active.filter(j => j.id !== jobId)
			store.pending = store.pending.filter(j => j.id !== jobId)
		} else {
			const data = await resp.json().catch(() => ({}))
			Alpine.store('activityError', 'Cancel failed: ' + (data.message || resp.statusText))
			if (btn) btn.disabled = false
		}
	} catch (e) {
		Alpine.store('activityError', 'Cancel failed: ' + e.message)
		if (btn) btn.disabled = false
	}
}

async function clearHistory(btn) {
	if (btn) btn.disabled = true
	try {
		const resp = await fetch('/activity/clear-history', {
			method: 'POST',
			headers: { 'Accept': 'application/json' },
		})
		if (resp.ok) {
			Alpine.store('activity').history = []
			Alpine.store('activity').hasMore = false
			Alpine.store('activity').page = 1
		} else {
			const data = await resp.json().catch(() => ({}))
			Alpine.store('activityError', 'Clear failed: ' + (data.message || resp.statusText))
		}
	} catch (e) {
		Alpine.store('activityError', 'Clear failed: ' + e.message)
	} finally {
		if (btn) btn.disabled = false
	}
}

async function clearFiltered(btn, search, status) {
	if (btn) btn.disabled = true
	try {
		const resp = await fetch('/activity/clear-filtered', {
			method: 'POST',
			headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
			body: JSON.stringify({ search, status }),
		})
		if (resp.ok) {
			const store = Alpine.store('activity')
			store.history = store.history.filter(r => {
				const matchesText = !search || r.discName.toLowerCase().includes(search.toLowerCase()) || r.titleName.toLowerCase().includes(search.toLowerCase())
				const matchesStatus = status === 'all' || r.status === status
				return !(matchesText && matchesStatus)
			})
		} else {
			const data = await resp.json().catch(() => ({}))
			Alpine.store('activityError', 'Clear failed: ' + (data.message || resp.statusText))
		}
	} catch (e) {
		Alpine.store('activityError', 'Clear failed: ' + e.message)
	} finally {
		if (btn) btn.disabled = false
	}
}

function formatBytes(bytes) {
	if (bytes >= 1024 * 1024 * 1024) return (bytes / (1024 * 1024 * 1024)).toFixed(1) + ' GB'
	return Math.round(bytes / (1024 * 1024)) + ' MB'
}

// Note: the modulo operator below uses "%%" because this script is passed through fmt.Sprintf at render time.
function formatDuration(secs) {
	if (secs < 60) return '<1m'
	const h = Math.floor(secs / 3600)
	const m = Math.floor((secs %% 3600) / 60)
	return h > 0 ? h + 'h ' + m + 'm' : m + 'm'
}

</script>`, data.StoreJSON))

		<div class="page-header">
			<h1>Activity</h1>
		</div>

		<div x-data x-show="$store.activity.contributionAvailable" x-cloak class="card alert-contribution">
			<p>
				<strong x-text="$store.activity.contributionDiscName"></strong> isn't in TheDiscDB yet.
				<a :href="'/contributions/' + $store.activity.contributionId">Contribute it</a> so others benefit!
			</p>
			<button @click="$store.activity.contributionAvailable = false" class="btn btn-sm mt-2">Dismiss</button>
		</div>

		if data.Flash != "" {
			<div x-data="{ show: true }" x-init="(function(){ var u = new URL(window.location); u.searchParams.delete('flash'); history.replaceState(null, '', u.toString()) })()" x-show="show" x-cloak class="alert alert-success flex justify-between items-center mb-4" role="status">
				<span>{ data.Flash }</span>
				<button @click="show = false" aria-label="Dismiss" class="btn-close-alert">&times;</button>
			</div>
		}

		<div x-data x-show="$store.activityError" x-cloak role="alert" aria-live="assertive" class="alert alert-error flex justify-between items-center mb-4">
			<span x-text="$store.activityError"></span>
			<button @click="$store.activityError = ''" aria-label="Dismiss" class="btn-close-alert">&times;</button>
		</div>

		<!-- Tab Bar -->
		<div class="tab-bar" x-data role="tablist" aria-label="Activity views"
			x-on:keydown.arrow-right.prevent="(function(){ const tabs = Array.from($el.querySelectorAll('[role=tab]')); const i = tabs.indexOf(document.activeElement); const next = tabs[(i+1)%tabs.length]; if(next){next.focus();next.click()} })()"
			x-on:keydown.arrow-left.prevent="(function(){ const tabs = Array.from($el.querySelectorAll('[role=tab]')); const i = tabs.indexOf(document.activeElement); const prev = tabs[(i-1+tabs.length)%tabs.length]; if(prev){prev.focus();prev.click()} })()"
			x-on:keydown.home.prevent="(function(){ const first = $el.querySelector('[role=tab]'); if(first){first.focus();first.click()} })()"
			x-on:keydown.end.prevent="(function(){ const tabs = $el.querySelectorAll('[role=tab]'); const last = tabs[tabs.length-1]; if(last){last.focus();last.click()} })()"
		>
			<button
				class="tab-btn"
				role="tab"
				:class="{'tab-active': $store.activityTab === 'active'}"
				:aria-selected="$store.activityTab === 'active'"
				:tabindex="$store.activityTab === 'active' ? '0' : '-1'"
				aria-controls="tab-panel-active"
				x-on:click="$store.activityTab = 'active'; const u = new URL(window.location); u.searchParams.set('tab', 'active'); history.pushState(null, '', u)"
			>
				Active &amp; Queued
				<template x-if="$store.activity.active.length + $store.activity.pending.length > 0">
					<span class="tab-count" x-text="$store.activity.active.length + $store.activity.pending.length"></span>
				</template>
			</button>
			<button
				class="tab-btn"
				role="tab"
				:class="{'tab-active': $store.activityTab === 'history'}"
				:aria-selected="$store.activityTab === 'history'"
				:tabindex="$store.activityTab === 'history' ? '0' : '-1'"
				aria-controls="tab-panel-history"
				x-on:click="$store.activityTab = 'history'; const u = new URL(window.location); u.searchParams.set('tab', 'history'); history.pushState(null, '', u)"
			>
				History
			</button>
		</div>

		<!-- ═══════════ Active & Queued Tab ═══════════ -->
		<!--
			Every state a salvage can be in, because it takes hours and the page is
			the only place the user can see it: copying, patching, checking, paused,
			finished, failed. Showing only some of them left the panel vanishing
			mid-operation with no way back to it.
		-->
		<div x-data x-show="$store.activity.salvagePhase" x-cloak class="card scan-warnings">
			<h2 class="section-title" x-text="({
				'starting': 'Salvaging this disc',
				'backing-up': 'Salvaging this disc',
				'rescuing': 'Salvaging this disc',
				'verifying': 'Salvaging this disc',
				'paused': 'Salvage paused',
				'done': 'Salvage finished',
				'failed': 'Salvage failed'
			})[$store.activity.salvagePhase] || 'Salvaging this disc'"></h2>

			<div class="flex items-center gap-2" x-show="$store.activity.salvageActive">
				<span class="spinner" aria-hidden="true"></span>
				<span x-text="({
					'starting': 'Starting',
					'backing-up': 'Copying the disc',
					'rescuing': 'Patching the damaged sections of the copy',
					'verifying': 'Reading the repaired copy'
				})[$store.activity.salvagePhase] || 'Working'"></span>
				<span class="text-secondary min-w-3ch" x-show="$store.activity.salvagePercent > 0" x-text="$store.activity.salvagePercent + '%'"></span>
			</div>

			<div class="progress-row" x-show="$store.activity.salvageActive && $store.activity.salvagePercent > 0">
				@components.ProgressBarDynamic("$store.activity.salvagePercent", "flex:1;")
			</div>

			<p class="text-muted text-sm" x-show="$store.activity.salvageActive && $store.activity.salvageStartedAt" x-text="(() => {
				const now = $store.activity.now
				if (!now || !$store.activity.salvageStartedAt) return ''
				return formatDuration(Math.max(0, Math.floor((now - $store.activity.salvageStartedAt) / 1000))) + ' elapsed'
			})()"></p>

			<p class="text-muted scan-operation" x-show="$store.activity.salvageMessage" x-text="$store.activity.salvageMessage"></p>

			<p class="text-muted" x-show="$store.activity.salvagePhase === 'done'" x-text="$store.activity.salvageUnrecovered > 0 ? 'Done. ' + formatBytes($store.activity.salvageUnrecovered) + ' could not be read and is blank in the result. The disc is ready to rip.' : 'Done. Everything was recovered. The disc is ready to rip.'"></p>

			<div class="mt-2" x-show="$store.activity.salvageActive">
				<button class="btn btn-secondary btn-sm" x-on:click="pauseSalvage($store.activity.salvageDriveIndex)">Pause</button>
				<span class="text-muted text-sm"> Stops the operation and keeps everything recovered so far</span>
			</div>

			<!--
				Paused and failed both leave work on disk that a resume continues from,
				so both offer it. Without this the panel was a dead end.
			-->
			<div class="mt-2" x-show="$store.activity.salvagePhase === 'paused' || $store.activity.salvagePhase === 'failed'">
				<button class="btn btn-primary btn-sm" x-on:click="resumeSalvage()">
					<span x-text="$store.activity.salvageResumable ? 'Resume salvage' : 'Start salvage again'"></span>
				</button>
				<span class="text-muted text-sm" x-show="$store.activity.salvageResumable"> Continues from where it stopped</span>
			</div>
		</div>
		<div id="tab-panel-active" role="tabpanel" aria-label="Active and queued jobs" x-data x-show="$store.activityTab === 'active'" x-cloak class="flex flex-col gap-5">
			<!-- Active Jobs -->
			<div class="card mb-4">
				<h2 class="section-title">Active</h2>
				<template x-if="$store.activity.active.length === 0">
					<div class="empty-state"><p>No active jobs.</p></div>
				</template>
				<template x-if="$store.activity.active.length > 0">
					<div>
						<template x-for="j in $store.activity.active" :key="j.id">
							<div class="card mb-3" :aria-label="'Rip job: ' + j.titleName">
								<div class="job-card-header">
									<div>
										<div class="font-semibold" x-text="j.titleName"></div>
										<div class="text-muted text-sm">
											<a :href="'/drives/' + j.driveIndex" class="text-primary no-underline" x-text="j.discName"></a>
										</div>
									</div>
									<span class="badge" :class="'badge-' + j.contentType" x-show="j.contentType" x-text="j.contentType"></span>
								</div>
								<div class="job-meta" x-show="j.sizeHuman || j.duration || (j.audioTracks && j.audioTracks.length) || (j.subtitleLanguages && j.subtitleLanguages.length)">
									<span x-show="j.sizeHuman || j.duration" x-text="[j.sizeBytes && j.progress > 0 && j.phase === 'copying' ? formatBytes(Math.round(j.sizeBytes * j.progress / 100)) + ' / ' + j.sizeHuman : j.sizeHuman, j.duration].filter(Boolean).join(' · ')"></span>
									<span x-show="j.audioTracks && j.audioTracks.length" x-text="(j.sizeHuman || j.duration ? ' · ' : '') + (j.audioTracks || []).map(t => [t.Codec, t.Channels, t.Language].filter(Boolean).join(' ')).join(', ')"></span>
									<span x-show="j.subtitleLanguages && j.subtitleLanguages.length" x-text="' · Subs: ' + (j.subtitleLanguages || []).join(', ')"></span>
								</div>
								<!--
									A rip from a salvaged copy contains damage. The card someone
									watches for twenty minutes said nothing about it.
								-->
								<template x-if="j.salvageNote">
									<div class="text-warning text-sm mt-1" x-text="j.salvageNote"></div>
								</template>
								<div class="progress-row" x-show="j.phase === 'analyzing'">
									<span class="spinner" aria-hidden="true"></span>
									<span class="text-secondary">Reading the disc structure&hellip;</span>
								</div>
								<div class="progress-row" x-show="j.phase !== 'analyzing'">
									<span class="text-secondary min-w-3ch" x-text="j.progress + '%'"></span>
									@components.ProgressBarDynamic("j.progress", "flex:1;")
								</div>
								<div class="text-muted text-sm mt-1" x-show="j.startedAt" x-text="j.startedAt ? (() => {
									const now = $store.activity.now
									if (!now) return ''
									const elapsed = Math.max(0, Math.floor((now - new Date(j.startedAt)) / 1000))
									const elapsedStr = formatDuration(elapsed)
									if (j.phase === 'analyzing') {
										return elapsedStr + ' elapsed \u00b7 copying has not started yet'
									}
									// Enough copied to average out, measured in bytes rather than
									// percent. Five percent of an 86 GB disc is 4.3 GB \u2014 about
									// five minutes with no estimate at all, which is
									// indistinguishable from a stall \u2014 while five percent of a
									// DVD is over in seconds. A fixed amount read gives every
									// disc the same short warm-up.
									const copied = j.phase === 'copying' && j.sizeBytes ? j.sizeBytes * j.progress / 100 : 0
									const enough = copied >= 500 * 1024 * 1024 || (!j.sizeBytes && j.progress >= 5)
									if (enough && j.progress > 0) {
										const total = elapsed / (j.progress / 100)
										const remaining = Math.max(0, total - elapsed)
										return elapsedStr + ' elapsed \u00b7 ~' + formatDuration(remaining) + ' remaining'
									}
									// Before that an estimate would swing wildly, but a blank
									// where a number used to be reads as information lost rather
									// than not yet known.
									return elapsedStr + ' elapsed \u00b7 estimating\u2026'
								})() : ''"></div>
								<div class="text-right mt-2">
									<button class="btn btn-danger btn-sm" x-on:click="cancelJob(j.id, $el)">Cancel</button>
								</div>
							</div>
						</template>
					</div>
				</template>
			</div>

			<!-- Pending Jobs -->
			<div class="card">
				<h2 class="section-title">Queued</h2>
				<template x-if="$store.activity.pending.length === 0">
					<div class="empty-state"><p>No pending jobs.</p></div>
				</template>
				<template x-if="$store.activity.pending.length > 0">
					<div>
						<template x-for="j in $store.activity.pending" :key="j.id">
							<div class="card mb-3" :aria-label="'Queued job: ' + j.titleName">
								<div class="job-card-header">
									<div>
										<div class="font-semibold" x-text="j.titleName"></div>
										<div class="text-muted text-sm">
											<a :href="'/drives/' + j.driveIndex" class="text-primary no-underline" x-text="j.discName"></a>
										</div>
									</div>
									<div class="flex gap-2 items-center">
										<span class="badge" :class="'badge-' + j.contentType" x-show="j.contentType" x-text="j.contentType"></span>
										<span class="badge badge-pending" x-text="j.status || 'pending'"></span>
									</div>
								</div>
								<div class="job-meta" x-show="j.sizeHuman || j.duration">
									<span x-text="[j.sizeHuman, j.duration].filter(Boolean).join(' · ')"></span>
								</div>
								<div class="text-right mt-2">
									<button class="btn btn-danger btn-sm" x-on:click="cancelJob(j.id, $el)">Remove</button>
								</div>
							</div>
						</template>
					</div>
				</template>
			</div>

			<template x-if="$store.activity.active.length === 0 && $store.activity.pending.length === 0">
				<div class="empty-state" style="padding: 2rem;">
					<p>No active or queued jobs. Insert a disc to get started.</p>
				</div>
			</template>
		</div>

		<!-- ═══════════ History Tab ═══════════ -->
		<div id="tab-panel-history" role="tabpanel" aria-label="Rip history" x-data="{ filter: '', statusFilter: 'all' }" x-show="$store.activityTab === 'history'" x-cloak>
			<div class="card">
				<!-- Filters -->
				<div class="flex gap-2 items-center mb-4">
					<label for="history-filter" class="sr-only">Filter by disc or title name</label>
					<input type="search" id="history-filter" x-model="filter" placeholder="Filter by disc or title name…" class="flex-1"/>
					<label for="history-status-filter" class="sr-only">Filter by status</label>
					<select id="history-status-filter" x-model="statusFilter" class="w-auto" style="min-width: 120px;">
						<option value="all">All Status</option>
						<option value="completed">Completed</option>
						<option value="failed">Failed</option>
						<option value="ripping">Ripping</option>
					</select>
					<button class="btn btn-danger btn-sm" @click="clearHistory($el)">Clear All</button>
					<button class="btn btn-danger btn-sm" @click="clearFiltered($el, filter, statusFilter)" :disabled="filter === '' && statusFilter === 'all'">Clear Visible</button>
				</div>

				<template x-if="$store.activity.history.length === 0">
					<div class="empty-state"><p>No rip history yet.</p></div>
				</template>
				<template x-if="$store.activity.history.length > 0">
					<div>
						<template x-for="r in $store.activity.history.filter(r => {
							const matchesText = !filter || r.discName.toLowerCase().includes(filter.toLowerCase()) || r.titleName.toLowerCase().includes(filter.toLowerCase())
							const matchesStatus = statusFilter === 'all' || r.status === statusFilter
							return matchesText && matchesStatus
						})" :key="r.id">
							<div class="card mb-3" :class="{'row-failed': r.status === 'failed'}">
								<div class="job-card-header">
									<div>
										<div class="font-semibold" x-text="r.titleName"></div>
										<div class="text-muted text-sm" x-text="r.discName"></div>
									</div>
									<div class="flex gap-2 items-center">
										<span class="badge" :class="'badge-' + r.contentType" x-show="r.contentType" x-text="r.contentType"></span>
										<span class="badge" :class="'badge-' + r.status" x-text="r.status"></span>
									</div>
								</div>
								<div class="job-meta" x-show="r.sizeHuman || r.duration || (r.audioTracks && r.audioTracks.length) || (r.subtitleLanguages && r.subtitleLanguages.length)">
									<span x-show="r.sizeHuman || r.duration" x-text="[r.sizeHuman, r.duration].filter(Boolean).join(' · ')"></span>
									<span x-show="r.audioTracks && r.audioTracks.length" x-text="(r.sizeHuman || r.duration ? ' · ' : '') + (r.audioTracks || []).map(t => [t.Codec, t.Channels, t.Language].filter(Boolean).join(' ')).join(', ')"></span>
									<span x-show="r.subtitleLanguages && r.subtitleLanguages.length" x-text="' · Subs: ' + (r.subtitleLanguages || []).join(', ')"></span>
								</div>
								<div class="text-muted text-sm">
									<span x-text="r.createdAt"></span>
									<template x-if="r.outputPath">
										<span> · <span x-text="r.outputPath"></span></span>
									</template>
									<template x-if="r.error">
										<span class="text-error"> · <span x-text="r.error"></span></span>
									</template>
								</div>
								<!--
									A rip that read the disc and came away with nothing is what a
									scratch looks like. Salvage can get past it, at the cost of
									damaged video where the disc is unreadable — so it is offered
									here and never taken without being asked for.
								-->
								<!--
									A salvaged rip contains damage the file cannot explain for
									itself. This is where someone finding a glitch months later
									learns why it is there.
								-->
								<template x-if="r.salvageNote">
									<div class="text-warning text-sm mt-1" x-text="r.salvageNote"></div>
								</template>
								<!--
									The copy this rip came off is still on disk, holding up to
									~100GB. This row is where someone looking at the finished file
									decides they are done with it, so the offer to reclaim the
									space belongs here and not only on the drive page.
								-->
								<template x-if="discHasBackup(r.discName)">
									<div class="mt-2">
										<button class="btn btn-secondary btn-sm"
											x-on:click="discardDiscBackup(r.discName)">Discard the scanned copy</button>
										<span class="text-muted text-sm"> Frees the space; a re-rip would have to read the disc again</span>
									</div>
								</template>
								<template x-if="r.salvageable">
									<div class="mt-2">
										<!--
											One salvage at a time: the server refuses a second, and a
											button that cannot do anything should not invite a click.
										-->
										<button class="btn btn-secondary btn-sm"
											x-bind:disabled="$store.activity.salvageActive"
											x-on:click="salvageDisc(r.driveIndex, r.discName)">
											<span x-text="r.salvageResumable ? 'Resume salvage…' : 'Salvage this disc…'"></span>
										</button>
										<span class="text-muted text-sm" x-show="!$store.activity.salvageActive" x-text="r.salvageResumable ? ' Continues from where the last attempt stopped' : ' Recover what is still readable, accepting damaged video'"></span>
										<span class="text-muted text-sm" x-show="$store.activity.salvageActive"> A salvage is already running</span>
									</div>
								</template>
							</div>
						</template>
					</div>
				</template>

				<!-- Pagination -->
				<div class="flex gap-2 items-center mt-3 justify-end">
					<template x-if="$store.activity.page > 1">
						<a :href="'/activity?tab=history&page=' + ($store.activity.page - 1)" aria-label="Previous page" class="btn btn-secondary btn-sm">&larr; Previous</a>
					</template>
					<span class="text-muted" x-text="'Page ' + $store.activity.page"></span>
					<template x-if="$store.activity.hasMore">
						<a :href="'/activity?tab=history&page=' + ($store.activity.page + 1)" aria-label="Next page" class="btn btn-secondary btn-sm">Next &rarr;</a>
					</template>
				</div>
			</div>
		</div>
	}
}
